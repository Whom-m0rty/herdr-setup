#!/usr/bin/env python3
"""Run a long job (tests, builds, before/after measurements) in a visible herdr pane, and tell you and the
agent that started it when it ends. No model, no tokens.

usage: job "<label>" [--cwd DIR] [--no-wake] -- <command ...>

- The job runs in a new tab of the "Jobs" workspace (outside herdr: in the background), output tee'd to
  $TODAY_HOME/jobs/<id>.log (default ~/.cache/today/jobs). Today shows it under "Background jobs".
- At the end: a herdr notification, and the Claude session that started it (HERDR_PANE_ID) gets a short
  prompt with the exit code and the log path, but only if that session is idle at that moment, so an agent can
  start a job, stop, and be woken when it finishes. --no-wake turns that off.
Prints the job id and log path, then returns at once.
"""
import datetime, json, os, shlex, subprocess, sys, time, uuid

JOBS = os.path.expanduser(os.environ.get("TODAY_HOME", "~/.cache/today")) + "/jobs"
ME = os.path.realpath(__file__)


def h(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True)
    try:
        return json.loads(out.stdout).get("result", {})
    except ValueError:
        return {}


def save(job):
    tmp = f"{JOBS}/{job['id']}.json.tmp"
    json.dump(job, open(tmp, "w"), indent=1)
    os.replace(tmp, f"{JOBS}/{job['id']}.json")


def start(argv):
    if "--" not in argv or len(argv) < 3:
        sys.exit(__doc__)
    split = argv.index("--")
    opts, cmd = argv[:split], argv[split + 1:]
    label = opts[0]
    cwd = opts[opts.index("--cwd") + 1] if "--cwd" in opts else os.getcwd()
    os.makedirs(JOBS, exist_ok=True)
    jid = datetime.datetime.now().strftime("%m%d-%H%M%S-") + uuid.uuid4().hex[:4]
    job = dict(id=jid, label=label, cmd=cmd, cwd=cwd, log=f"{JOBS}/{jid}.log", started=time.time(), exit=None,
               pane=os.environ.get("HERDR_PANE_ID", ""), wake="--no-wake" not in opts, sid="")
    if job["pane"]:
        agent = h("agent", "get", job["pane"]).get("agent", {})
        job["sid"] = (agent.get("agent_session") or {}).get("value", "")
    save(job)
    # a herdr pane does not inherit this environment: pass the state dir on
    runner = f"TODAY_HOME={shlex.quote(os.path.dirname(JOBS))} {shlex.quote(sys.executable)} {shlex.quote(ME)} --run {jid}"
    if os.environ.get("HERDR_ENV") == "1":
        ws = next((w["workspace_id"] for w in h("workspace", "list").get("workspaces", []) if w["label"] == "Jobs"), None)
        if ws:
            tab = h("tab", "create", "--workspace", ws, "--cwd", cwd, "--label", label[:28], "--no-focus")
            pane = tab["root_pane"]["pane_id"]
        else:
            r = h("workspace", "create", "--label", "Jobs", "--cwd", cwd, "--no-focus")
            h("tab", "rename", r["tab"]["tab_id"], label[:28])
            pane = r["root_pane"]["pane_id"]
        h("pane", "run", pane, runner)
        where = "herdr workspace Jobs"
    else:
        subprocess.Popen([sys.executable, ME, "--run", jid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        where = "background"
    print(f"job {jid} started ({where}); log {job['log']}")


def run(jid):
    job = json.load(open(f"{JOBS}/{jid}.json"))
    with open(job["log"], "w") as log:
        log.write(f"$ {shlex.join(job['cmd'])}   (in {job['cwd']})\n")
        log.flush()
        proc = subprocess.Popen(job["cmd"], cwd=job["cwd"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1)
        last = ""
        for line in proc.stdout:
            sys.stdout.write(line)
            log.write(line)
            if line.strip():
                last = line.strip()
                job["last"] = last[:200]
        code = proc.wait()
    job.update(exit=code, ended=time.time(), last=last[:200])
    save(job)
    took = int(job["ended"] - job["started"])
    verdict = "finished" if code == 0 else f"FAILED (exit {code})"
    h("notification", "show", f"Job {verdict}: {job['label']}", "--body", f"{took // 60}m{took % 60}s · {last[:120]}",
      "--sound", "done" if code == 0 else "request")
    if job["wake"] and job["pane"]:
        agent = h("agent", "get", job["pane"]).get("agent", {})
        same = (agent.get("agent_session") or {}).get("value", "") == job["sid"]
        if same and agent.get("agent_status") in ("idle", "done"):
            h("agent", "prompt", job["pane"],
              f"[job] '{job['label']}' {verdict} after {took // 60}m{took % 60}s. Log: {job['log']}. "
              "Read the end of the log and carry on with the next step (report the result to me first if it "
              "changes the plan).")
    print(f"\n[job {verdict}; this tab can be closed]")


if __name__ == "__main__":
    if len(sys.argv) > 2 and sys.argv[1] == "--run":
        run(sys.argv[2])
    else:
        start(sys.argv[1:])
