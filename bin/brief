#!/usr/bin/env python3
"""Right-hand pane next to a Claude session in herdr: what this session is about and where it stopped.

usage: brief <session id>

Shows the session's name and what it needs from you, its task from todo.md, its brief file
($TODAY_HOME/briefs/<sid8>.md, kept by the session itself), your last message and Claude's last reply.
Keys: c close after a handoff (brief update first) · C close now · f full last reply · r redraw.
No model, no tokens. Started by `today all` next to every open Claude pane.
"""
import os, select, shutil, subprocess, sys, termios, textwrap, time, tty
from importlib.machinery import SourceFileLoader

BIN = os.path.dirname(os.path.realpath(__file__))
al = SourceFileLoader("agentlib", f"{BIN}/agentlib").load_module()
tv = SourceFileLoader("todo_view", f"{BIN}/todo-view").load_module()
B, D, R, Y, G, C, X = "\033[1m", "\033[2m", "\033[31m", "\033[33m", "\033[32m", "\033[36m", "\033[0m"
KIND = {"working": G, "you": R, "close": C, "paused": D}


def task_of(sid):
    """The open task tagged with this session, or None."""
    tagged = [t for t in tv.parse_todo() if any(sid.startswith(p) for p in t["sids"])]
    return tagged[0] if tagged else None


def wrap(text, width, indent=""):
    out = []
    for para in text.splitlines():
        out += textwrap.wrap(para, max(10, width - len(indent)), initial_indent=indent,
                             subsequent_indent=indent) or [""]
    return out


def render(sid, full, once=False):
    cols, rows = shutil.get_terminal_size()
    w = max(20, cols - 1)
    agent = next((a for a in al.herdr("agent", "list").get("agents", [])
                  if (a.get("agent_session") or {}).get("value") == sid), None)
    brief = al.read_brief(sid)
    task = task_of(sid)
    done = not task and any(sid.startswith(p) for p in tv.done_sids())
    label, kind = al.verdict(agent, task_done=done, quick=sid in al.quick_sids()) if agent else ("closed", "paused")
    out = []
    name = brief.get("name") or (tv.display_text(task["text"]) if task else "") or sid[:8]
    out.append(f"{B}{name[:w]}{X}")
    out.append(f"{KIND.get(kind, '')}● {label}{X}  {D}{sid[:8]}{X}")
    if task and brief.get("name") and task["text"] != brief.get("name"):
        out += wrap(f"task (#{task['area']}, {task['section']}): {tv.display_text(task['text'])}", w)[:2]
    out.append("")
    if brief:
        age = al.ago(time.time() - brief["mtime"])
        out.append(f"{C}── brief, {age} ago ──{X}")
        body = "\n".join(l for l in brief["text"].splitlines() if not l.lower().startswith("name:"))
        out += wrap(body.strip(), w)
    else:
        out.append(f"{D}no brief yet: it appears after the session's first milestone{X}")
    user, said, _ = al.tail(sid)
    if user:
        out.append("")
        out.append(f"{C}── you said ──{X}")
        out += wrap(user, w)[:4]
    if said:
        out.append("")
        out.append(f"{C}── Claude ──{X}")
        lines = wrap(said, w)
        room = max(4, rows - len(out) - 3)
        out += lines if full else lines[-room:]
    footer = f"{D}c close (handoff) · C close now · f full reply · r redraw{X}"
    if len(out) > rows - 2 and not full:
        out = out[:rows - 2]
    if once:
        text = "\n".join(out)
        print(text if sys.stdout.isatty() else tv.ANSI.sub("", text))
        return agent
    sys.stdout.write(f"\033]0;brief {sid[:8]}\007\033[H\033[2J\033[3J" + "\n".join(out)
                     + f"\033[{rows};1H" + footer)
    sys.stdout.flush()
    return agent


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    sid = sys.argv[1]
    if "--once" in sys.argv or not sys.stdin.isatty():
        render(sid, True, once=True)
        return
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    full, status = False, ""
    try:
        while True:
            agent = render(sid, full)
            if status:
                sys.stdout.write(f"\033[1;1H\033[2K{Y}{status}{X}")
                sys.stdout.flush()
            ready, _, _ = select.select([sys.stdin], [], [], 5)
            if not ready:
                continue
            ch = al.latin(sys.stdin.read(1))
            if ch == "f":
                full = not full
            elif ch in ("c", "C") and agent:
                if ch == "c" and agent.get("agent_status") == "working":
                    status = "still working: wait, or C to close now"
                    continue
                cmd = [f"{BIN}/agent-close", agent["pane_id"], sid] + (["--now"] if ch == "C" else [])
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                status = "closing: handoff first…" if ch == "c" else "closing…"
            elif ch == "r":
                status = ""
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
