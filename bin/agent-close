#!/usr/bin/env python3
"""Close a Claude session pane in herdr, after a handoff.

usage: agent-close <agent pane id> <session id> [--now]

Without --now: asks the session to update its brief, waits until it is idle again (max 10 minutes), then closes
the agent pane and its brief pane. It does not close when the pane's folder has uncommitted git changes, or when
the session ends up waiting for a permission. The session itself is kept: Today (or `claude --resume <id>`)
brings it back. Runs in the background; the result shows as a herdr notification and in $TODAY_HOME/closed.log.
"""
import datetime, os, subprocess, sys
from importlib.machinery import SourceFileLoader

BIN = os.path.dirname(os.path.realpath(__file__))
al = SourceFileLoader("agentlib", f"{BIN}/agentlib").load_module()
h = al.herdr
LOG = f"{al.STATE_DIR}/closed.log"

HANDOFF = ("I am closing this session now. Before that, in this order, without starting any new work: "
           "1) update your brief file {path} (format in CLAUDE.md, section 'Session brief') so the next session can "
           "pick up exactly where this one stopped: status, what is done, the next step, what we wait on, and "
           "promises to people that are not in my todo list yet. "
           "2) If a git checkout of this session has uncommitted changes, say which one. "
           "Then reply with one line.")


def note(title, body):
    os.makedirs(al.STATE_DIR, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(f"{datetime.datetime.now():%Y-%m-%d %H:%M} {title}: {body}\n")
    subprocess.run(["herdr", "notification", "show", title, "--body", body[:200], "--sound", "none"],
                   capture_output=True)


def brief_panes(pane):
    """Brief panes showing this agent: same tab, terminal title 'brief <sid8>'."""
    info = h("pane", "get", pane).get("pane", {})
    tab = info.get("tab_id")
    out = []
    for p in h("pane", "list", "--workspace", info.get("workspace_id", "")).get("panes", []):
        if p.get("tab_id") == tab and p.get("terminal_title_stripped", "").startswith("brief "):
            out.append(p["pane_id"])
    return out


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    pane, sid = sys.argv[1], sys.argv[2]
    name = al.read_brief(sid).get("name") or sid[:8]
    if "--now" not in sys.argv:
        h("agent", "prompt", pane, HANDOFF.format(path=al.brief_path(sid)))
        h("agent", "wait", pane, "--until", "working", "--timeout", "30000")
        h("agent", "wait", pane, "--until", "idle", "--until", "done", "--until", "blocked", "--timeout", "600000")
        status = h("agent", "get", pane).get("agent", {}).get("agent_status")
        if status in ("blocked", "working"):
            note("Not closed", f"{name}: the session is {status} after the handoff; look at it")
            return
    agent = h("agent", "get", pane).get("agent", {})
    folder = al.agent_folder(agent)
    al._DIRTY.clear()
    if al.dirty(folder):
        note("Not closed", f"{name}: uncommitted changes in {os.path.basename(folder)}")
        return
    briefs = brief_panes(pane)
    h("pane", "close", pane)
    for b in briefs:
        h("pane", "close", b)
    note("Session closed", f"{name} ({sid[:8]}); reopen from Today")


if __name__ == "__main__":
    main()
